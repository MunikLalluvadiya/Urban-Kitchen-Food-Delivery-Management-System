# ==============================================================================
# Urban Kitchen – Food & Beverage
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and set your own secure secrets before launching.
# Example: cp .env.example .env

# Flask Session Security Key
# Must be kept confidential in production.
# Example strong random default:
# SECRET_KEY=4a8f9c1e2b3d5e7f0a8b9c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f
SECRET_KEY=

# Restaurant Operations Manager Password (/admin/login)
# Used to manage restaurants, menu prices, and item availability.
# Example strong default:
# ADMIN_PASSWORD=UrbanKitchen@2026!Admin
ADMIN_PASSWORD=
